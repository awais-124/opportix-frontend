          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/jobs",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs"],
              "query": [
                { "key": "category", "value": "1", "disabled": true },
                { "key": "status", "value": "active", "disabled": true },
                { "key": "type", "value": "remote", "disabled": true },
                { "key": "duration", "value": "full_time", "disabled": true },
                { "key": "experience", "value": "mid_level", "disabled": true },
                { "key": "search", "value": "developer", "disabled": true }
