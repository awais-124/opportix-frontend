          }
        },
        {
          "name": "Get Jobs by Category",
          "description": "Fetch jobs for a specific category with optional filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/categories/1/jobs?status=active&type=remote",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "1", "jobs"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "type", "value": "remote" },
                { "key": "duration", "value": "full_time", "disabled": true },
                { "key": "experience", "value": "mid_level", "disabled": true },
                { "key": "search", "value": "developer", "disabled": true }
